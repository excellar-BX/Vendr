{
  "name": "vendr-backend",
  "version": "1.0.0",
  "description": "Vendr backend API",
  "main": "dist/app.js",
 "scripts": {
  "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
  "build": "tsc && prisma generate && node --max-old-space-size=460 ./node_modules/typescript/bin/tsc",
  "start": "node dist/app.js"
},
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1021.0",
    "@aws-sdk/s3-request-presigner": "^3.1021.0",
    "@fastify/cors": "^11.2.0",
    "@prisma/adapter-neon": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "fastify": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.5",
    "resend": "^6.10.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.0",
    "prisma": "^7.6.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}