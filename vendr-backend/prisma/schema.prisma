generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                         String            @id @default(uuid())
  email                      String            @unique
  password                   String?
  full_name                  String?
  avatar_url                 String?
  phone                      String?
  google_id                  String?           @unique
  is_verified                Boolean           @default(false) // Email verification
  is_vendor_verified         Boolean           @default(false) // Vendor identity verification (CAC, NIN, etc.)
  is_buyer                   Boolean           @default(true)
  is_vendor                  Boolean           @default(false)
  is_deleted                 Boolean           @default(false)
  deleted_at                 DateTime?
  notifications_enabled      Boolean           @default(true)
  language                   String            @default("English")
  font_size                  String            @default("Normal")
  push_token                 String?
  role                       String            @default("user")
  plan                       String            @default("free") // free, pro
  plan_started_at            DateTime?
  plan_expires_at            DateTime?
  last_withdrawal_at         DateTime?
  created_at                 DateTime          @default(now())
  updated_at                 DateTime          @updatedAt

  refresh_tokens             RefreshToken[]
  email_verification_tokens  EmailVerificationToken[]
  password_reset_tokens      PasswordResetToken[]
  vendors                    Vendor[] @relation("UserVendors")
  orders                     Order[]
  reviews                    Review[]
  savedVendors               SavedVendor[]
  notifications              Notification[]
  transactions               Transaction[] @relation("UserTransactions")
  counterpartyTransactions   Transaction[] @relation("CounterpartyTransactions")
  userPresence               UserPresence?
  bankAccounts               BankAccount[]
  virtualAccount             VirtualAccount?
  wallet                     Wallet?
  paymentRequests            PaymentRequest[]
  searchHistories            SearchHistory[]
  disputes                   Dispute[]
  reelsPosted                Reel[]
  reelLikes                  ReelLike[]
  reelSaves                  ReelSave[]
  messages                   Message[]
  conversations              Conversation[] @relation("ConversationParticipants")
  vendorReports              VendorReport[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDOR & PRODUCTS
// ─────────────────────────────────────────────────────────────────────────────

model Vendor {
  id                 String   @id @default(uuid())
  user_id            String
  shop_name          String
  description        String?
  category           String?
  city               String?
  address            String?
  logo_url           String?
  banner_url         String?
  avatar_url         String?  // Store profile picture (different from logo)
  lat                Float?
  lng                Float?
  phone              String?
  whatsapp           String?
  instagram          String?
  twitter            String?
  open_days          String[] @default(["Mon", "Tue", "Wed", "Thu", "Fri"])
  open_time          String   @default("08:00")
  close_time         String   @default("20:00")
  verification_tier  String?  // basic, premium
  plan               String   @default("free") // free, pro
  plan_started_at    DateTime?
  plan_expires_at    DateTime?
  is_active          Boolean  @default(true)
  is_suspended       Boolean  @default(false)
  suspended_at       DateTime?
  suspended_reason   String?
  rating             Float    @default(0)
  review_count       Int      @default(0)
  is_fraud_flagged   Boolean  @default(false)
  fraud_flag_reason  String?
  fraud_flagged_at   DateTime?
  monthly_revenue_goal Float   @default(2000000)
  monthly_orders_goal Int      @default(150)
  monthly_visitors_goal Int    @default(5000)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  user              User             @relation("UserVendors", fields: [user_id], references: [id], onDelete: Cascade)
  products          Product[]
  orders            Order[]
  reviews           Review[]
  savedBy           SavedVendor[]
  conversations     Conversation[]
  reels             Reel[]
  paymentRequests   PaymentRequest[]
  verificationRequests VerificationRequest[]
  walletTransactions WalletTransaction[]
  disputes          Dispute[]
  vendorReports     VendorReport[]
  analytics         VendorAnalytics[]
  productAnalytics  ProductAnalytics[]

  @@map("vendors")
}

model Product {
  id             String   @id @default(uuid())
  vendor_id      String
  name           String
  description    String?
  price          Float
  image_url      String?
  is_available   Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  reels Reel[]
  analytics ProductAnalytics[]

  @@map("products")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORDERS & PAYMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id               String   @id @default(uuid())
  buyer_id         String
  vendor_id        String
  vendor_user_id   String  // Denormalized for quick access to vendor's user record
  payment_request_id String?
  conversation_id  String?
  amount           Float
  description      String?
  order_type       String   @default("pickup") // pickup, delivery
  delivery_address String?
  otp_code         String?  // 4-digit; exposed to buyer only via API
  otp_confirmed    Boolean  @default(false)
  otp_confirmed_at DateTime?
  buyer_confirmed_at DateTime? // pickup: buyer confirmed receipt
  status           String   @default("pending") // pending, completed, refunded, disputed
  escrow_status    String   @default("held") // held, disputed, released, refunded
  delivery_confirmed_at DateTime?
  auto_release_at  DateTime?
  created_at       DateTime @default(now())

  buyer   User      @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  vendor  Vendor    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversation_id], references: [id], onDelete: SetNull)
  paymentRequest PaymentRequest? @relation(fields: [payment_request_id], references: [id], onDelete: SetNull)
  disputes Dispute[]

  @@map("orders")
}

model VerificationRequest {
  id                String   @id @default(uuid())
  vendor_id         String
  status            String   @default("pending") // pending, approved, rejected
  submitted_at      DateTime @default(now())
  reviewed_at       DateTime?
  reviewer_id       String?
  rejection_reason  String?
  cac_number        String?
  nin_number       String?
  business_address  String?
  documents         Json?    @default("{}") // Store document URLs
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@map("verification_requests")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  vendor_id   String
  order_id    String? 
  amount      Float
  tx_type     String   // escrow_hold, escrow_release, debit, refund
  status      String   @default("pending") // pending, completed, frozen
  notes       String?
  metadata    Json?    @default("{}")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
}

model Dispute {
  id           String   @id @default(uuid())
  order_id     String
  buyer_id     String
  vendor_id    String
  reason       String
  description  String?
  evidence_urls Json?   @default("[]")
  status       String   @default("open") // open, resolved, dismissed
  resolution   String?  // refund_buyer, release_vendor
  admin_notes  String?
  resolved_at  DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  order  Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)
  buyer  User   @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@map("disputes")
}

model PaymentRequest {
  id               String   @id @default(uuid())
  vendor_id        String
  buyer_id         String
  conversation_id  String?
  amount           Float
  description      String?
  status           String   @default("pending") // pending, paid, cancelled, expired
  paid_at          DateTime?
  created_at       DateTime @default(now())
  vendor_user_id   String?  // Denormalized

  buyer   User      @relation(fields: [buyer_id], references: [id], onDelete: Cascade)
  vendor  Vendor    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(name: "ConversationPaymentRequest", fields: [conversation_id], references: [id], onDelete: SetNull)
  orders Order[]

  @@map("payment_requests")
}

model Transaction {
  id              String   @id @default(uuid())
  user_id         String
  type            String   // credit, debit, withdrawal, payment_sent, payment_received, refund
  amount          Float
  status          String   @default("success") // pending, success, failed
  reference       String?  @unique
  description     String?
  counterparty_id String?
  metadata        Json?    @default("{}")
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now()) @updatedAt
  provider        String   @default("monnify")

  user User @relation(name: "UserTransactions", fields: [user_id], references: [id], onDelete: Cascade)
  counterparty User? @relation(name: "CounterpartyTransactions", fields: [counterparty_id], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Wallet {
  id              String   @id @default(uuid())
  user_id         String   @unique
  available_balance Float  @default(0)
  frozen_balance   Float  @default(0)
  currency        String   @default("NGN")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model BankAccount {
  id            String   @id @default(uuid())
  user_id       String
  account_number String
  account_name  String
  bank_name     String
  bank_code     String
  recipient_code String?
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model VirtualAccount {
  id              String   @id @default(uuid())
  user_id         String   @unique
  account_number  String
  account_name    String
  bank_name       String
  provider_reference String?
  created_at      DateTime @default(now())
  provider        String   @default("monnify")
  reference       String?  @unique

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("virtual_accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// CHAT & CONVERSATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id                String   @id @default(uuid())
  buyer_id          String
  vendor_id         String
  last_message      String?
  last_message_at   DateTime @default(now())
  buyer_unread      Int      @default(0)
  vendor_unread     Int      @default(0)
  created_at        DateTime @default(now())

  buyer   User    @relation("ConversationParticipants", fields: [buyer_id], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  messages Message[]
  paymentRequests PaymentRequest[] @relation(name: "ConversationPaymentRequest")
  orders Order[]

  @@unique([buyer_id, vendor_id])
  @@map("conversations")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_id       String
  content         String?
  image_url       String?
  type            String   @default("text") // text, image, payment_request, system
  is_read         Boolean  @default(false)
  delivered       Boolean  @default(false)
  edited          Boolean  @default(false)
  deleted         Boolean  @default(false)  // soft delete instead of hard delete
  deleted_at      DateTime?                 // when was it deleted
  reply_to_id     String?                   // for reply feature
  created_at      DateTime @default(now())

  conversation Conversation   @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User           @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  reply_to     Message?       @relation("MessageReplies", fields: [reply_to_id], references: [id], onDelete: SetNull)
  replies      Message[]      @relation("MessageReplies")
  reactions    MessageReaction[]

  @@map("messages")
}

model MessageReaction {
  id         String   @id @default(uuid())
  message_id String
  user_id    String
  emoji      String   // "❤️", "😂", "👍", "🔥", "😮", "😢"
  created_at DateTime @default(now())

  message Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id])
  @@map("message_reactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENT & ENGAGEMENT (REELS)
// ─────────────────────────────────────────────────────────────────────────────

model Reel {
  id            String   @id @default(uuid())
  vendor_id     String
  user_id       String  // Who posted the reel (can be vendor or buyer?)
  video_url     String
  thumbnail_url String?
  caption       String?
  product_id    String?
  view_count    Int      @default(0)
  like_count    Int      @default(0)
  save_count    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  vendor  Vendor       @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [product_id], references: [id], onDelete: SetNull)
  likes   ReelLike[]
  saves   ReelSave[]

  @@map("reels")
}

model ReelLike {
  id      String   @id @default(uuid())
  reel_id String
  user_id String
  created_at DateTime @default(now())

  reel  Reel @relation(fields: [reel_id], references: [id], onDelete: Cascade)
  user  User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, reel_id])
  @@map("reel_likes")
}

model ReelSave {
  id      String   @id @default(uuid())
  reel_id String
  user_id String
  created_at DateTime @default(now())

  reel  Reel @relation(fields: [reel_id], references: [id], onDelete: Cascade)
  user  User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, reel_id])
  @@map("reel_saves")
}

// ─────────────────────────────────────────────────────────────────────────────
// SOCIAL & INTERACTIONS
// ─────────────────────────────────────────────────────────────────────────────

model SavedVendor {
  id        String   @id @default(uuid())
  user_id   String
  vendor_id String
  created_at DateTime @default(now())

  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vendor_id])
  @@map("saved_vendors")
}

model Review {
  id        String   @id @default(uuid())
  vendor_id String
  user_id   String
  rating    Int      // 1-5
  comment   String?
  created_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vendor_id]) // One review per user per vendor
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS & UTILITIES
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  user_id   String
  type      String?
  title     String
  body      String
  is_read   Boolean  @default(false)
  data      Json?    @default("{}")
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SearchHistory {
  id        String   @id @default(uuid())
  user_id   String
  query     String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("search_history")
}

model UserPresence {
  user_id    String   @id
  is_online  Boolean  @default(false)
  last_seen  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

model Waitlist {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  type      String?
  created_at DateTime @default(now())

  @@map("waitlist")
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDOR REPORTS
// ─────────────────────────────────────────────────────────────────────────────

model VendorReport {
  id          String   @id @default(uuid())
  vendor_id   String
  user_id     String
  reason      String   // fraud, fake_products, inappropriate_content, harassment, other
  description String?
  status      String   @default("pending") // pending, reviewed, resolved, dismissed
  admin_notes String?
  reviewed_at DateTime?
  reviewed_by String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, vendor_id])
  @@map("vendor_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// VENDOR ANALYTICS
// ─────────────────────────────────────────────────────────────────────────────

model VendorAnalytics {
  id              String   @id @default(uuid())
  vendor_id       String
  date            DateTime @default(now()) // Daily aggregation date
  profile_views   Int      @default(0)
  product_views   Int      @default(0)
  inquiries       Int      @default(0) // Messages/conversations initiated
  revenue         Float    @default(0) // Total revenue for the period
  orders_count    Int      @default(0)
  unique_visitors Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, date])
  @@map("vendor_analytics")
}

model ProductAnalytics {
  id              String   @id @default(uuid())
  product_id      String
  vendor_id       String
  date            DateTime @default(now()) // Daily aggregation date
  views           Int      @default(0)
  orders_count    Int      @default(0)
  revenue         Float    @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([product_id, date])
  @@map("product_analytics")
}
 